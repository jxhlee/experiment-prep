# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
# Vercel 에 배포할 때는 같은 이름으로 Project Settings > Environment Variables 에도 넣고 다시 배포해야 합니다.

# 서버 전용: 서비스 API 로 Gemini 를 호출할 때 쓰는 키 (브라우저에 노출되지 않음)
GEMINI_API_KEY=

# Supabase (선택): 비워 두면 로그인·저장 기능이 숨겨지고 나머지는 그대로 동작합니다.
# Supabase 대시보드 > Project Settings > API 에서 복사합니다.
# 아래 두 값은 브라우저에 공개되어도 안전한 값입니다. 접근 제한은 DB 의 RLS 가 담당합니다.
# service_role(secret) 키는 절대 여기에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
